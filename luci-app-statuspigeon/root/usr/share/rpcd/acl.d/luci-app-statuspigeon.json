{
  "luci-app-statuspigeon": {
    "description": "Status Pigeon agent configuration",
    "read": {
      "uci": [ "statuspigeon" ],
      "file": {
        "/usr/bin/statuspigeon-status": [ "exec" ]
      }
    },
    "write": {
      "uci": [ "statuspigeon" ],
      "file": {
        "/usr/bin/statuspigeon-report": [ "exec" ]
      }
    }
  }
}
